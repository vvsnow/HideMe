<Window x:Class="HideMe.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://caliburnmicro.com"
        Width="900"
        Height="550"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <Button Content="文件浏览器" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        cal:Message.Attach="GoBrowser" />
                <Button Content="隐藏列表" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        cal:Message.Attach="GoHiddenList" />
                <Button Content="设置" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        cal:Message.Attach="GoSettings" />
            </StackPanel>
        </Border>

        <!-- 当前页面 -->
        <ContentControl Grid.Column="1" x:Name="ActiveItem" Margin="4" />
    </Grid>
</Window>
