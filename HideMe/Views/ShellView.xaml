<Window
    x:Class="HideMe.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:vm="clr-namespace:HideMe.ViewModels"
    Title="HideMe"
    Width="1080"
    Height="720"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    ui:FramelessHelper.CaptionHeight="100"
    ui:FramelessHelper.IsFrameless="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid WindowChrome.IsHitTestVisibleInChrome="True">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧导航：导航区位于标题栏高度内，需标记为可点击  -->
        <ListBox
            Margin="6"
            Background="Transparent"
            DisplayMemberPath="Title"
            ItemsSource="{Binding NavItems, Mode=OneWay}"
            SelectedValue="{Binding ActiveItem}"
            SelectedValuePath="ViewModel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <ui:SimpleStackPanel Spacing="3" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  右上角主题切换按钮  -->
            <ui:SimpleStackPanel
                Grid.Row="0"
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    cal:Message.Attach="ToggleTheme"
                    Style="{StaticResource ThemeButtonStyle}"
                    ToolTip="切换主题"
                    ToolTipService.HorizontalOffset="-14"
                    ToolTipService.Placement="Top"
                    ToolTipService.VerticalOffset="-2" />
            </ui:SimpleStackPanel>

            <ContentControl
                x:Name="ActiveItem"
                Grid.Row="1"
                IsTabStop="False" />

        </Grid>

    </Grid>

</Window>
