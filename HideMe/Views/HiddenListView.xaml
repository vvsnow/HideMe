<UserControl x:Class="HideMe.Views.HiddenListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button Content="扫描" cal:Message.Attach="Scan" />
                <Button Content="恢复选中项" Margin="8,0,0,0" cal:Message.Attach="Show" />
                <Button Content="取消" Margin="8,0,0,0" cal:Message.Attach="Cancel"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ProgressBar Height="16" Margin="0,4,0,0" Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原路径" Binding="{Binding OriginalPath}" Width="*" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="60" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180" />
                <DataGridTextColumn Header="隐藏时间" Binding="{Binding HiddenAt}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
