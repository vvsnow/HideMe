<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HideMe</RootNamespace>
    <AssemblyName>HideMe</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © 2026</Copyright>
    <!-- DPI 感知（PerMonitorV2）必须由 exe 自己声明 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Caliburn.Micro" Version="4.0.230" />
    <PackageReference Include="LightUi" Version="1.0.12" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!--
      旧的项目文件里由 SettingsSingleFileGenerator 生成的设置类，基类 ApplicationSettingsBase
      属于 .NET Framework 专属的 System.Configuration，现代 .NET 不再提供；项目里也没有任何地方使用它。
      文件保留在磁盘上（未删除），只是不参与编译。
    -->
    <Compile Remove="Properties\Settings.Designer.cs" />
    <!--
      旧式项目手写的程序集信息（含 WPF ThemeInfo）。现代 SDK 会自动生成这些特性，
      再编译旧文件会重复（CS0579）；文件保留在磁盘上，只是不参与编译。
    -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
